# Copy to .env and fill in. .env is git-ignored (never commit secrets).

# --- Database ---
DATABASE_URL=postgresql+psycopg://leadint:leadint@localhost:5432/leadint

# --- Redis (queue / rate-limit buckets; used Phase 1b+) ---
REDIS_URL=redis://localhost:6379/0

# --- Apify (scraping provider) ---
APIFY_TOKEN=

# --- Gemini (LLM extraction; free tier at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model IDs (override only if needed).
# Note: gemini-2.5-flash/pro are 404 for new API keys, and gemini-2.0-flash
# returns 429 "limit: 0" (no free tier) on some accounts/regions. gemini-flash-latest
# is a rolling alias that currently has free-tier quota. If it starts failing, probe
# models with a minimal generateContent call and switch to whichever returns 200.
EXTRACTION_MODEL=gemini-flash-latest
ESCALATION_MODEL=gemini-flash-latest

# --- Extraction tuning ---
# Below this confidence, escalate the post to the stronger model.
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
