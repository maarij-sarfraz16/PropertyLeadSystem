# Copy to .env and fill in. .env is git-ignored (never commit secrets).

# --- Database ---
DATABASE_URL=postgresql+psycopg://leadint:leadint@localhost:5432/leadint

# --- Redis (queue / rate-limit buckets; used Phase 1b+) ---
REDIS_URL=redis://localhost:6379/0

# --- Apify (scraping provider) ---
APIFY_TOKEN=

# --- Anthropic (LLM extraction) ---
ANTHROPIC_API_KEY=
# Model IDs (override only if needed)
EXTRACTION_MODEL=claude-haiku-4-5-20251001
ESCALATION_MODEL=claude-sonnet-4-6

# --- Extraction tuning ---
# Below this confidence, escalate the post to the stronger model.
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
