# Copy to .env and fill in. .env is git-ignored (never commit secrets).
# Everything below has a working default except the secrets — the system scans, extracts
# and streams with no configuration at all beyond DATABASE_URL.

# --- Database ---
DATABASE_URL=postgresql+psycopg://leadint:leadint@localhost:5432/leadint

# --- Redis (reserved for multi-process realtime fan-out and rate-limit buckets) ---
REDIS_URL=redis://localhost:6379/0

# --- Apify (optional) ---
# Only used if a source row sets `apify_actor_id` in its config. Zameen scans its own
# search payload directly by default, so no token is required.
APIFY_TOKEN=

# --- Gemini (LLM extraction; free tier at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model IDs (override only if needed).
# Note: gemini-2.5-flash/pro are 404 for new API keys, and gemini-2.0-flash
# returns 429 "limit: 0" (no free tier) on some accounts/regions. gemini-flash-latest
# is a rolling alias that currently has free-tier quota. If it starts failing, probe
# models with a minimal generateContent call and switch to whichever returns 200.
EXTRACTION_MODEL=gemini-flash-latest
ESCALATION_MODEL=gemini-flash-latest

# --- Extraction tuning ---
# Below this confidence, escalate the post to the stronger model.
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
# Call the LLM at all. false = rule-based extraction only (no API cost, lower confidence).
EXTRACTION_ENABLED=true
# Fall back to rule-based extraction when the LLM errors or runs out of quota, so a
# provider outage never stops lead production.
EXTRACTION_FALLBACK_ENABLED=true

# --- Background scan worker -------------------------------------------------
# The worker starts with the API. Set false to run the API without scanning (e.g. when
# scanning runs as its own process via `python -m app.scan --watch`).
SCAN_ENABLED=true
# Seconds between scan cycles. 10-30 is a good development cadence; 60-300 is kinder to
# the source in production. Duplicate work is filtered before any LLM call, so a short
# interval costs little beyond one HTTP request per cycle.
SCAN_INTERVAL_SECONDS=30
# Grace period before the first cycle, so the API is serving before scanning begins.
SCAN_STARTUP_DELAY_SECONDS=2
# Comma-separated sources the worker scans each cycle.
SCAN_SOURCES=zameen
# Listings pulled from the source per cycle (one page).
SCAN_PAGE_SIZE=25
# Listings ingested on the very first cycle, before a watermark exists. Keeps an empty
# database from triggering a burst of LLM calls on startup.
SCAN_BACKFILL_LIMIT=10
# Hard cap on new listings processed per cycle. Bounds LLM spend; a backlog spreads over
# subsequent cycles rather than stalling one long cycle.
SCAN_MAX_NEW_PER_CYCLE=10
# Exponential backoff after a failed cycle: first delay, and its ceiling.
SCAN_ERROR_BACKOFF_SECONDS=15
SCAN_ERROR_BACKOFF_MAX_SECONDS=300

# --- Source: Zameen ---------------------------------------------------------
ZAMEEN_BASE_URL=https://www.zameen.com
# Comma-separated search paths, polled newest-first. Add cities/categories here to widen
# coverage — e.g. /Homes/Islamabad-3-1.html or /Plots/Lahore-1-1.html
# Homes + Plots + Commercial across Lahore/Karachi, so every property-type filter in the
# dashboard (Apartment, House, Plot, Commercial) has real listings behind it, not just Homes.
ZAMEEN_SEARCH_PATHS=/Homes/Lahore-1-1.html,/Homes/Karachi-2-1.html,/Plots/Lahore-1-1.html,/Plots/Karachi-2-1.html,/Commercial/Lahore-1-1.html,/Commercial/Karachi-2-1.html
ZAMEEN_REQUEST_TIMEOUT_SECONDS=30

# --- Realtime ---------------------------------------------------------------
# Per-subscriber event buffer. A lagging client drops its oldest events rather than
# growing this queue without limit.
REALTIME_QUEUE_SIZE=100
# Keepalive interval, in seconds. Must stay below any proxy idle timeout (often 30-60s).
REALTIME_HEARTBEAT_SECONDS=20

# --- API --------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# true emits newline-delimited JSON for log shipping; false is human-readable.
LOG_JSON=false
